{
  "name": "smarthr-backend",
  "version": "1.0.0",
  "description": "SmartHR & Payroll - Backend API (NestJS)",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "db:test:payroll": "node scripts/prepare-payroll-api-test-db.js",
    "test:payroll": "node node_modules/ts-node/dist/bin.js tests/payroll-engine.spec.ts",
    "test:time-attendance": "node node_modules/ts-node/dist/bin.js tests/time-attendance-engine.spec.ts",
    "test:payroll:api": "node node_modules/ts-node/dist/bin.js tests/payroll-api.integration.ts",
    "start:test:payroll-api": "node scripts/start-payroll-api-test-server.js",
    "typeorm:ts": "node -r ts-node/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm:ts -- migration:generate -d src/typeorm.config.ts",
    "migration:run:local": "npm run typeorm:ts -- migration:run -d src/typeorm.config.ts",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/typeorm.config.js",
    "migration:show": "npm run typeorm:ts -- migration:show -d src/typeorm.config.ts",
    "start": "node dist/main",
    "start:dev": "node node_modules/ts-node/dist/bin.js src/main.ts",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.36",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  }
}
